{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/el/api/cron/hent-priser",
      "schedule": "*/10 2,10-15 * * *"
    },
    {
      "path": "/el/api/cron/udsend",
      "schedule": "* 14,15 * * *"
    },
    {
      "path": "/el/api/cron/udsend",
      "schedule": "*/5 16-18 * * *"
    },
    {
      "path": "/el/api/cron/ryd-op",
      "schedule": "23 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/el"
    },
    {
      "source": "/:path((?!el/|el$|_next/).*)",
      "destination": "/el/:path"
    }
  ]
}
