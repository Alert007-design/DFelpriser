# Kopiér til .env.local lokalt. I produktion sættes værdierne i Vercel → Settings → Environment Variables.
# Læg ALDRIG rigtige værdier i denne fil.

# Spærre: tilmelding og udsendelse til rigtige modtagere kræver, at denne er "ja" (først efter juridisk godkendelse).
JURA_GODKENDT=nej
# Kommaseparerede e-mails, der må tilmelde sig og modtage mail, før JURA_GODKENDT=ja.
TESTMODTAGERE=
# "ja" tillader søgemaskiner. Standard nej, indtil lanceringen er godkendt.
OFFENTLIG=nej

# Database: EGET Supabase-projekt til DF-Elpriser (må ikke deles med DF-priser). Transaction pooler, port 6543.
DATABASE_URL=

# E-mail (Resend). Eget domæne/afsender til DF-Elpriser.
RESEND_API_KEY=
MAIL_FROM=DF-Elpriser <onboarding@resend.dev>
MAIL_REPLY_TO=

# Offentlig adresse for denne app (bruges i links i mails).
APP_URL=http://localhost:3000

# Lang tilfældig streng (openssl rand -base64 48). Signerer afmeldingslinks og adminlogin. Ændres den, holder gamle links op med at virke.
TOKEN_HEMMELIGHED=
# Vercel Cron sender "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Adgangskode til /admin
ADMIN_PASSWORD=
# Modtager af fejl- og forsinkelsesbeskeder (valgfri).
ADMIN_EMAIL=

# Prisdata: "test" = opdigtede testdata (sendes aldrig til rigtige modtagere), "live" = Energi Data Service.
PRISKILDE=test
# Hvor mange dage oplysninger om afmeldte gemmes som dokumentation, før de slettes (standard 365; jurist fastlægger).
AFMELDT_OPBEVARING_DAGE=365
